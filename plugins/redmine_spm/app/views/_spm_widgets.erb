<div id="issue_spm" style="<%= cookies[:issue_spm_toggle]? 'height 365px; ' : '' %>background-color: #fff; display: block; padding-right: 5px">
<div class="contextual">
  <a id="issue_spm_max" href="#spm_max">Maximize</a>
  <span id="spm_expand_section">
  &nbsp;|&nbsp;
  <a id="issue_spm_toggle" href="javascript:void(0)"><%= cookies[:issue_spm_toggle]? 'Collapse' : 'Expand'%></a>
  </span>
  
</div>
<p><strong>Related stored procedures</strong> </p>

<div id="issue_spm_widgets" style="<%= cookies[:issue_spm_toggle]? '' : 'display: none; '%>margin:0px;padding:0px;overflow:hidden; height: 335px">
	<iframe 
	src="https://api.ndict.now/RedmineIssue/List/<%= @issue.id %><%= cookies[:issue_spm_toggle]? '#open' : '#closed'%>" 
    style="overflow:hidden;height:100%;width:100%" height="100%" width="100%"
    frameborder="0" scrolling="no"></iframe>	
</div>

<%= javascript_include_tag 'spm-redmine-widgets.js', :plugin => 'redmine_spm' %>

</div>