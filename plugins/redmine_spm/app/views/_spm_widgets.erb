<hr />
<div id="issue_spm">
<div class="contextual">
  <a id="issue_spm_toggle" href="javascript: void(0)"><%= cookies[:issue_spm_toggle]? 'Collapse' : 'Expand'%></a>
</div>
<p><strong>Related store procedures</strong></p>

<div id="issue_spm_widgets" style="<%= cookies[:issue_spm_toggle]? '' : 'display: none'%>">
	<iframe 
	src="//10.18.200.105:3000/widgets/issue/<%= @issue.id %>/storeprocedure.html?author=<%= User.current.login %>" 
	width="99%" height="250px" frameborder="0" scrolling="no"></iframe>	
</div>

<script>
	
	function issue_spm_toggle(){
		if($.cookie("issue_spm_toggle")) {
			$("#issue_spm_widgets").hide();
			$("#issue_spm_toggle").html("Expand");
			$.removeCookie("issue_spm_toggle", {path: "/"});	
		}
		else {
			$("#issue_spm_widgets").show();
			$("#issue_spm_toggle").html("Collapse");			
			$.cookie("issue_spm_toggle", "show", {path: "/"});
		}		
	}

	$("#issue_spm_toggle").click(issue_spm_toggle);	
	
</script>

</div>