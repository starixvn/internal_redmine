
<form method="get" id="query_form" action="/people/<%=@person.id %>" accept-charset="UTF-8">
	
	<input name="tab" type="hidden" value="spent_time" />
	<input name="utf8" type="hidden" value="✓" />
	<input name="f[]" type="hidden" value="spent_on" />
	<input name="f[]" type="hidden" value="user_id" />
	<input name="op[user_id]" type="hidden" value="=" />	
	<input name="v[user_id][]" type="hidden" value="<%=@person.id %>" />
	<input name="c[]" type="hidden" value="project" />
	<input name="c[]" type="hidden" value="spent_on" />
	<input name="c[]" type="hidden" value="activity" />
	<input name="c[]" type="hidden" value="issue" />
	<input name="c[]" type="hidden" value="comments" />
	<input name="c[]" type="hidden" value="hours" />
	
	<label for="operators_spent_on"> Date</label>
	<span style="padding-left: 50px">
		<select onchange="$('#query_form').submit(); return false;" name="op[spent_on]" id="operators_spent_on">
			<option value="t">today</option>
			<option value="ld">yesterday</option>
			<option value="w">this week</option>
			<option value="lw">last week</option>
			<option value="l2w">last 2 weeks</option>
			<option value="m" selected="selected">this month</option>
			<option value="lm">last month</option>
			<option value="y">this year</option>
			<option value="*">any</option></select>	
		<script>
			$(document).ready(function(){
				$('#operators_spent_on').val("<%= @date %>");				
			})			
		</script>	
	</span>
</form>

<% if @query != nil %>

<div id="total-hours" class="total-hours">
<p><%= l(:label_total_time) %>: <%= html_hours(l_hours(@total_hours)) %></p>
</div>

<div class="autoscroll">
<table class="list time-entries">
<thead>
  <tr>
    <% @query.inline_columns.each do |column| %>
      <th><%= h(column.caption) %></th>
    <% end %>
  </tr>
</thead>
<tbody>
<% @entries.each do |entry| -%>
  <tr class="time-entry <%= cycle("odd", "even") %>">
    <%= raw @query.inline_columns.map {|column| "<td class=\"#{column.css_classes}\">#{column_content(column, entry)}</td>"}.join %>
  </tr>
<% end -%>
</tbody>
</table>
</div>

<% else %>

<script>
	$('#tab-spent_time').removeAttr("onclick");
</script>

<% end %>

<a href="/time_entries?f[]=spent_on&op[spent_on]=lm&f[]=user_id&op[user_id]=%3D&v[user_id][]=<%=@person.id %>&f[]=&c[]=project&c[]=spent_on&c[]=user&c[]=activity&c[]=issue&c[]=comments&c[]=hours">Spent time »</a>
