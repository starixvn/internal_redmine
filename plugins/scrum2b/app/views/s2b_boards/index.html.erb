<%= render :partial => "/shared/plugin_header", :locals => {:is_board => true, :member => @member, :list_versions_open => @list_versions_open, :list_versions_closed => @list_versions_closed} %>
<div class="container-fluid">
  <%= render :partial => "screen_board", :locals => { :id_member =>@id_member ,:new_issues => @new_issues ,:started_issues => @started_issues ,:completed_issues => @completed_issues,:issue => @issue,
                                                      :tracker => @tracker , :priority => @priority,:member => @member,:status => @status,:sprints => @sprints} %>

</div>
<script>

  function initialize() {
      $("#completed").find(".icon_close_issue").show();

      $(".icon_close_issue").live("click", function () {
          if (!confirm('<%= l(:label_sure_to_close_issues)%>')) {
              return;
          }

          var issue_id = $(this).parent().attr("value")
          var project_id = <%= @project.id %>
          var url_ajax = 'close_on_board'

          $.ajax({
              url: url_ajax,
              type: "POST",
              data: 'issue_id=' + issue_id + '&project_id=' + project_id,
              dataType: "script",
              success: function () {
                  makeSumEstTimeNSpentTime();
              }
          });
          return false;
      });

      $("#btn_filter_issues_on_board").live("click", function () {
          var select_version = $("#select_version_onboard").val()
          var select_member = $("#select_member").val()
          var project_id = <%= @project.id %>
          var url_ajax = 'filter_issues_onboard'
          $.ajax({
              url: url_ajax,
              type: "POST",
              data: 'select_version=' + select_version + '&select_member=' + select_member + '&project_id=' + project_id,
              dataType: "script",
              success: function () {}
          });

          return false;
      });

      $("#new, #started, #completed").sortable({
          scroll: true,
          scrollSensitivity: 100,
          scrollSpeed: 100,
          connectWith: ".connectedSortable",
          sort: function () {
              $(this).find(".ui-sortable-helper").addClass("check");
          },
          receive: function () {
              var status = $(this).attr("id")
              var project_id = <%= @project.id %>
              var url_ajax = 'update_status'
              var issue_id = $(this).find(".check").attr("id")
              if (status == "completed") {
                  $(this).find(".icon_close_issue").show();
              }
              if (status == "started") {
                  $(this).find(".icon_close_issue").hide();
              }
              if (status == "new") {
                  $(this).find(".icon_close_issue").hide();
              }
              $.ajax({
                  url: url_ajax,
                  type: "POST",
                  data: 'issue_id=' + issue_id + '&project_id=' + project_id + '&status=' + status,
                  dataType: "json",
                  success: function (res) {
                      if (res.status == "completed") {
                          makeSlider(issue_id, res.done_ratio);
                      }

                      makeSumEstTimeNSpentTime();
                  },
                  error: makeSumEstTimeNSpentTime
              });
          },
          stop: function () {
              var issue_id = $(".check").attr("id");
              var url_sort = 'sort'
              var project_id = <%= @project.id %> ;
              var id_next = $(".check").next().attr("id");
              var id_prev = $(".check").prev().attr("id");
              var old_status = $(this).attr("value");
              var new_status = $(".check").parent().attr("value");
              $(".check").removeClass("check");
              console.debug(id_prev);
              $.ajax({
                  url: url_sort,
                  type: "POST",
                  data: 'issue_id=' + issue_id + '&id_prev=' + id_prev + '&project_id=' + project_id + '&id_next=' + id_next + '&new_status=' + new_status + '&old_status=' + old_status,
                  dataType: "text",
                  success: function () {
                      makeSumEstTimeNSpentTime();
                  },
                  error: makeSumEstTimeNSpentTime
              });
          }
      });

      $(".slider-horizontal").each(function () {
          var id = parseInt($(this).parent().attr("value"));
          var slide_value = $(this).attr("value");
          makeSlider(id, slide_value);
      });

      $(".progressbar").each(function () {
          var id = parseInt($(this).parent().attr("value"))
          $("#progress" + id).progressbar({
              value: parseInt($(this).attr("value"))
          });
      });

      $(".icon_edit_issue").live("click", function () {
          var id_issue = parseInt($(this).parent().attr("value"));
          $(".icon_edit_issue").show();
          $(this).hide();
          $("#completed").find(".icon_close_issue").show();
          $("#close_" + id_issue).hide();
          $(".editing").hide();
          $(".no_edit").show();
          $("#edit_issue_" + id_issue).show();
          $("#show_issue_" + id_issue).hide();
          $(".hide").hide();
      });

      $(".cancel_issue").live("click", function () {
          var id_issue = parseInt($(this).parent().attr("value"));
          $("#completed").find("#close_" + id_issue).show();
          $("#edit_issue_" + id_issue).hide();
          $("#show_issue_" + id_issue).show();
          $(".icon_edit_issue").show();
          $(".readmore").show();
          $(".hide").hide();
          $(".description_readmore").hide();
          $("#edit_issue_").hide();
      });

      $(".submit_issue").live("click", function () {
          var id_issue = $(this).parent().attr("value");
          if (id_issue != "") {
              var url_ajax = "update";
          } else {
              var url_ajax = "create";
          }

          var slide_value = $("#slider" + id_issue).attr("value");
          $.ajax({
              url: url_ajax,
              type: "POST",
              data: $('#update_issue_' + id_issue).serialize(),
              dataType: "json",
              success: function (data) {
                  if (data.result == "edit_success") {
                      console.debug("get value :" + data.edit_content);
                      $("#show_issue_" + id_issue).replaceWith(data.content).show();
                      makeSlider(id_issue, slide_value);
                      $("#edit_issue_" + id_issue).replaceWith(data.edit_content).hide();
                      editDate(id_issue);
                      form_edit(id_issue);
                      $("#completed").find(".icon_close_issue").show();

                      if ($("#new_sprint_" + id_issue).val() != $("#select_version_onboard").val() && $("#select_version_onboard").val() != "all") {
                          $("#" + id_issue).hide();
                      }

                  } else if (data.result == "create_success") {
                      $("#edit_issue_").find(".value_content").val("");
                      $("#edit_issue_").hide();
                      $("#edit_issue_").after(data.content);                      
                      makeSlider(data.id, 0);
                      $("#" + data.id).wrap("<li id='"+ data.id +"'>");
                      editDate(data.id);
                      form_edit(data.id);
                  } else {
                      alert(data.message);
                  }

                  makeSumEstTimeNSpentTime();
              },
              error: makeSumEstTimeNSpentTime
          });
      });

      $(".editing").each(function () {
          var id = $(this).attr("value");
          editDate(id);
          if (id != "") {
              form_edit(id);
          }
      })

      $(".readmore").live("click", function () {
          var id = $(this).attr("value");
          $(this).hide();
          $("#hide_" + id).show();
          $("#description_readmore_" + id).show();
          $("#description_hide_" + id).hide();
          return false;
      });

      $(".hide").live("click", function () {
          var id = $(this).attr("value");
          $(this).hide();
          $("#readmore_" + id).show();
          $("#description_hide_" + id).show();
          $("#description_readmore_" + id).hide();
          return false;
      });

      $("#date_start_").datepicker();
      $("#date_end_").datepicker();
      $("#ate_start_").datepicker("option", "dateFormat", "yy-mm-dd");
      $("#date_end_").datepicker("option", "dateFormat", "yy-mm-dd");

      $(".icon_new_issue").live("click", function () {
      	 $("#edit_issue_").show();     
         $("#edit_issue_").addClass("board_issue");
         editDate("");
      });

      makeSumEstTimeNSpentTime();
      makeTooltip();      
  };

  function form_edit(id) {
      $("#p_status_" + id).hide();
      $("#p_priority_" + id);
      $("#p_tracker_" + id).hide();
      $("#p_sprint_" + id);
  }

  function editDate(id) {
      $("#new_date_start_" + id).datepicker();
      $("#new_date_end_" + id).datepicker();
      $("#new_date_start_" + id).datepicker("option", "dateFormat", "yy-mm-dd");
      $("#new_date_end_" + id).datepicker("option", "dateFormat", "yy-mm-dd");

      $("#new_date_start_" + id).datepicker("setDate", $("#new_date_start_" + id).attr("date"));
      $("#new_date_end_" + id).datepicker("setDate", $("#new_date_end_" + id).attr("date"));

  }

  function makeSlider(id, slide_value) {
      $("#slider" + id).slider({
          orientation: "horizontal",
          range: "min",
          min: 0,
          max: 100,
          value: parseInt(slide_value),
          slide: function (event, ui) {
              $("#amount" + id).val(ui.value);
          },
          stop: function (e, ui) {
              var issue_id = parseInt($(this).parent().attr("value"));
              var project_id = <%= @project.id %> ;
              var url_ajax = "update_progress";
              $.ajax({
                  url: url_ajax,
                  type: "POST",
                  data: 'done_ratio=' + ui.value + '&issue_id=' + issue_id + '&project_id=' + project_id,
                  dataType: "json",
                  success: function (res) {
                      $("#slider" + issue_id).attr("value", ui.value);
                  }
              });
          }
      });
      $("#amount" + id).val($("#slider" + id).slider("value"));
      $("#main-menu .s2b-lists").addClass("selected");          
  }

  function makeSumEstTimeNSpentTime() {
      var estText = "Est. ",
          spentText = "Spent ",
          hourText = "h",
          roundNo = 100;
      // new column
      var total_est_new = 0;
      $("#new p.estimated span").each(function () {
          var est = $(this).html();
          total_est_new += isNaN(est) ? 0 : parseFloat(est);
      });

      total_est_new = Math.round(total_est_new * roundNo) / roundNo;
      $("#total-est-new").html(estText + total_est_new + hourText);

      var total_spent_new = 0;
      $("#new p.total-hours span").each(function () {
          var spent = $(this).html();
          total_spent_new += isNaN(spent) ? 0 : parseFloat(spent);
      });

      total_spent_new = Math.round(total_spent_new * roundNo) / roundNo;
      $("#total-spent-new").html(spentText + total_spent_new + hourText);
      $("#div_news span.time-sum").css("visibility", "visible");


      // inprogress column
      var total_est_inprogress = 0;
      $("#started p.estimated span").each(function () {
          var est = $(this).html();
          total_est_inprogress += isNaN(est) ? 0 : parseFloat(est);
      });

      total_est_inprogress = Math.round(total_est_inprogress * roundNo) / roundNo;
      $("#total-est-inprogress").html(estText + total_est_inprogress + hourText);

      var total_spent_inprogress = 0;
      $("#started p.total-hours span").each(function () {
          var spent = $(this).html();
          total_spent_inprogress += isNaN(spent) ? 0 : parseFloat(spent);
      });

      total_spent_inprogress = Math.round(total_spent_inprogress * roundNo) / roundNo;
      $("#total-spent-inprogress").html(spentText + total_spent_inprogress + hourText);
      $("#div_progress span.time-sum").css("visibility", "visible");

      // completed column
      var total_est_completed = 0;
      $("#completed p.estimated span").each(function () {
          var est = $(this).html();
          total_est_completed += isNaN(est) ? 0 : parseFloat(est);
      });

      total_est_completed = Math.round(total_est_completed * roundNo) / roundNo;
      $("#total-est-completed").html(estText + total_est_completed + hourText);

      var total_spent_completed = 0;
      $("#completed p.total-hours span").each(function () {
          var spent = $(this).html();
          total_spent_completed += isNaN(spent) ? 0 : parseFloat(spent);
      });

      total_spent_completed = Math.round(total_spent_completed * roundNo) / roundNo;
      $("#total-spent-completed").html(spentText + total_spent_completed + hourText);
      $("#div_completed span.time-sum").css("visibility", "visible");

	  $("#div_screen_board").css("visibility", "visible");
  }

  function makeTooltip() {
	  $('#div_screen_board .board_issue').each(function() {
	  	var text = $("textarea[name='issue[description]']", this).text();
	  	var title = $(".subject", this).text();

		$(".subject", this).qtip({ // Grab some elements to apply the tooltip to
		    content: {
		    	title: title,
		        text: text
		    },
		    style: { 
		    	classes: 'qtip-bootstrap qtip-shadow qtip-rounded description_tooltip'
		    },
		    position: {
		    	at: "bottom right",
		        target: $(".id", this),
		        viewport: $(window)
		    },
            hide: {
                fixed: true,
                delay: 300
            }
		});
	  });  
  }

  initialize();

</script>