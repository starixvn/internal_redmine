<% if  params[:select_version] != 'backlog' && issues_backlog.empty? != true%>
  <tr class="version_row">
    <td colspan="6"><%= l(:label_version_backlog)%></td>
    <td><span class="total-spent-version"></span></td>
    <td><span class="total-est-version"></span></td>
    <td></td>
  </tr>
<% end %>
<% issues_backlog.each do |issue|%>
  <tr class="issue_row">
    <%= render :partial => "list_issues", :locals => { :issue => issue} %>
  </tr>
<% end %>